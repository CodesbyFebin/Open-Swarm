# Open Swarm Environment Configuration

# Workspace
WORKSPACE_PATH=/workspace

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODELS=qwen2.5-coder:3b,qwen3:8b,qwen2.5-coder:14b

# LiteLLM Proxy
LITELLM_HOST=http://localhost:4000
LITELLM_MASTER_KEY=sk-open-swarm

# API
API_HOST=0.0.0.0
API_PORT=8000

# Docker
DOCKER_ENABLED=true
SANDBOX_IMAGE=openswarm/agent:latest

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/openswarm.log
